# ============================================
# .env (Traefik proxy stack)
# Variables consumed by traefik/docker-compose.yaml
# AND traefik/dynamic/my-cms.yml (the dynamic routing config).
#
# Copy this file to traefik/.env next to docker-compose.yaml and edit.
# ============================================

# ---------- Routing ----------
# CMS_HOST             — Host() rule for all four Traefik routers
#                         (admin, api, studio, supabase-api)
# CMS_ADMIN_ORIGIN     — CORS origin allowed for the admin frontend
# CMS_SUPABASE_ORIGIN  — CORS origin allowed for supabase-api / Kong
#
# NOTE: Traefik is the public-facing entry point. It is NOT the URL
# the my-cms-api container uses to reach Kong — that path uses
# SUPABASE_INTERNAL_URL=http://supabase-kong:8000 on the shared
# Docker network (see ../apps/.env.example). Traefik routing is for
# browser/host traffic only.
CMS_HOST=localhost
CMS_ADMIN_ORIGIN=http://localhost:3002
CMS_SUPABASE_ORIGIN=http://localhost

# ---------- Website ----------
CMS_WEBSITE_HOST=ducth.dev

# ---------- Trusted visitor-IP forwarders ----------
# Traefik accepts X-Forwarded-* only from these CIDRs. Keep this list aligned
# with Cloudflare's published ranges before each production rollout:
# https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
# Do not set Traefik's forwardedHeaders.insecure=true in production.
TRAEFIK_ENTRYPOINTS_WEB_FORWARDEDHEADERS_TRUSTEDIPS=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# ---------- Basic Auth (Supabase Studio) ----------
# Generate a new hash: npx htpasswd-js -b -n admin "your-password"
# Format: user:$apr1$... or user:$2y$...
STUDIO_BASIC_AUTH_USERS=admin:$2y$05$5dcJrN0MmpA1xPeFnCgGfeGXpiHtqCVSRxBvYP8NOXgoRaS3NoSoW
