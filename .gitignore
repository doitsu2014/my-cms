# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

dist
.dioxus
.DS_Store

secret.env
.env.local
development.env
uat.env
production.env

deployments/charts/**/secret.values.yaml

.idea/
**/test-llvm-reports
lcov.info

node_modules
dist

# Docker compose
.env
docker-compose.override.yml
.pnpm-store

# Local dev env files (split per compose folder, see deployments/docker-swarm/README.md)
deployments/docker-swarm/*/.env

# Docker volumes (db data, secrets, runtime mounts) — created by containers
deployments/docker-swarm/volumes/
deployments/docker-swarm/supabase/volumes/
deployments/docker-swarm/supabase/volumes/db/data/*
deployments/docker-swarm/supabase/volumes/secrets/*

# Allow the example env files (one per component folder)
!deployments/docker-swarm/*/.env.example
# Added by code-review-graph
.code-review-graph/
.worktrees/

# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.claude/settings.local.json
# END AI-DLC:gitignore
